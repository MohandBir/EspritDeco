{% extends 'base.html.twig' %}

{% block title %}Voir Produit!{% endblock %}

{% block body %}

<div class="row g-3 d-flex justify-content-center">
    <div class="col-12 col-md-12 col-lg-12">
        <div class="card mb-3 h-100 px-3 py-3">
            <div class=" card-header d-flex flex-column justify-content-center align-items-center text-center">
                <h3>{{ product.title }}</h3>
                <hr class="w-50  mx-auto" >
                <span class="fs-5 opacity-75">{{product.category.name}}</span>

            </div>
            {% if product.images is not empty %}
            {# caroussel #}
            <div id="carouselExampleControls" class="carousel slide">
                <div class="carousel-inner">
                    {% for image in product.images %}
                    <div class="carousel-item {{ image.isPrincipal === true ? 'active' : ''}}">
                        <img src="{{ asset(image.path) }}" class="d-block mx-auto my-5" alt="{{image.alt}}" width="150px" height="150px" >
                    </div>
                    {% endfor %}
                </div>
                {% if product.images|length !== 1 %}
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
                {% endif %}
            </div>
            {# caroussel #}
            {% else %}
            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                <span style="font-size: 5rem;">🚫</span>
            </div>
            {% endif %}

            <div class="card-body">
                <p class="card-text opacity-75">{{ product.description }} </p>
            </div>

            <div
                class="card-footer  d-flex flex-column flex-md-row justify-content-around align-items-center gap-2 ">
                <span class="btn-price btn btn-primary rounded-4 d-block w-25 ">{{product.price}} €</span>
                <button class="btn-gradient rounded-5 d-block w-25 text-white">Ajouter au panier</button>
            </div>
        </div>
    </div>

</div>


{% endblock %}