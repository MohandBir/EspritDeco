{% extends 'base.html.twig' %}

{% block title %}Hello ProductController!{% endblock %}

{% block body %}

<div class="row g-3">
{% for product in products %}
<div class="col-12 col-md-6 col-lg-3">
    <div class="card mb-3 h-100 ">
        <h3 class="card-header d-lg-flex justify-content-center align-items-center text-center min-h-lg-80" >{{ product.title }}</h3>
        {% if product.images is not empty %}
            {% set image = product.images|first %}
            <img src="{{ asset(image.path) }}" class="card-img-top" alt="{{ image.alt }}" height="400px">
        {% else %}
            <div class="bg-light d-flex align-items-center justify-content-center"
                style="height: 200px;">
                <span style="font-size: 5rem;" >🚫</span>
            </div>
        {% endif %}

        <div class="card-body">
            <p class="card-text opacity-75">{{ product.description|split(' ')|length >= 20 ? product.description|split(' ')|slice(0, 20)|join(' ') ~ '...' : product.description }} </p>
        </div>


        <div class="card-footer text-muted d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span class="fs-5  d-block">{{product.category.name}}</span>
            <span class="btn btn-primary rounded-4  d-block ">{{product.price}} €</span>
        </div>
    </div>
</div>
{% endfor %}
</div>
  

{% endblock %}
