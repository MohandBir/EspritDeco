{% extends 'base.html.twig' %}

{% block title %}Ajout produit{% endblock %}

{% block body %}
{# affichage des messages #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
    <div class="alert alert-dismissible alert-{{label}}">
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    <p class="text-center mb-0"> {{message}}</p>
    </div>
    {% endfor %}
{% endfor %}

<h1 class="text-center py-5">Ajouter un produit</h1>

{{ form_start(form)}}
{{ form_widget(form)}}
<input type="submit" value="Enregistrer">
{{ form_end(form)}}

<div class="text-center mb-2">
    {% set referer = app.request.headers.get('referer') %}

    {% if referer and referer starts with app.request.scheme ~ '://' ~ app.request.host %}
        <a href="{{ referer }}" class="btn btn-primary" >Retour</a>
    {% elseif is_granted('ROLE_ADMIN') %}
        <a href="{{path('app_admin_product_index')}}" class="btn btn-primary" >Retour</a>
    {% else %}
        <a href="{{path('app_product_index')}}" class="btn btn-primary" >Retour</a>        
    {% endif %}
</div>
{% endblock %}