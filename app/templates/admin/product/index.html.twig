{% extends 'base.html.twig' %}

{% block title %}produits{% endblock %}

{% block body %}
<h1 class="text-center py-5">Gestion des produits</h1>
<div class="text-center mb-3">
    <a href="#" class="btn-primary rounded-4 px-1 text-decoration-none">➕</a>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th class="text-center">Titre</th>
            <th class="text-center">Prix</th>
            <th class="text-center">Categorie</th>
            <th class="text-center">Modifier</th>
            <th class="text-center">Supprimer</th>
        </tr>
    </thead>
    <tbody>
        {% for product in products %}
            <tr class="table-{{loop.index % 2 ? 'light' : 'secondary'}} ">
                <th class="text-center">
                    <a href="{{path('app_product_show', {id: product.id})}}" class="text-decoration-none">{{ product.title }}</a>
                </th>
                <td class="text-center ">{{ product.price }}</td>
                <td class="text-center">{{ product.category.name }}</td>
                <td class="text-center">​✏️​</td>
                <td class="text-center">​❌</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
<div class="text-center mb-2">
    <a href="{{path('app_admin_index')}}" class="btn btn-primary" >Retour</a>
</div>
{% endblock %}