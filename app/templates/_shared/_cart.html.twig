<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasExample" aria-labelledby="offcanvasExampleLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="offcanvasExampleLabel">Mon panier</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="">
            <table class="table table-hover">
                <tbody id="cartLines">
                    {# for #}
                    {% if cartHandler.getCartProducts() is not empty %}
                   
                        {% for product in cartHandler.getCartProducts() %} 
                            <tr class="table-light">
                                <td>{{product.title}}</td>
                                <td>
                                    <span class="btn btn-primary rounded-4 py-0 px-2 decreaseBtn"
                                    data-id="{{ product.id }}"
                                    data-price="{{ product.price }}"
                                    >-</span>
                                    <span class="qtyNumber">{{cartHandler.getCart()[product.id]}}</span>
                                    <span class="btn btn-primary rounded-4 py-0 px-2 increaseBtn"
                                    data-id="{{product.id}}"
                                    data-price="{{product.price}}"
                                    >+</span>
                                </td>
                                <td class="price">{{cartHandler.getCart()[product.id] * product.price}}</td>
                            </tr>
                        {% endfor %}
                    
                        {# end block #}
                        <tr>
                            <td>
                                <a href="" class="btn btn-primary rounded-4 py-0 px-1" id="clearCart"> Vider la panier</a>
                            </td>
                            <td>TOTAL</td>
                            <td> <span id="totalPrice">{{cartHandler.getTotalPrice()}}</span> €</td>
                        </tr>
                        {% else %}
                            <tr class="table-light">
                                <td class="text-center fs-5"> Votre panier est vide 🚫</td>           
                            </tr>
                        {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

 